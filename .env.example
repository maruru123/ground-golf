# グラウンドゴルフ管理システム 環境変数サンプル
# このファイルをコピーして .env を作成してください（.env は Git 管理外）。
#   cp .env.example .env

# --- 開発（ローカル / SQLite）の例 ---
# DATABASE_URL="file:./dev.db"

# --- 本番（Neon / PostgreSQL）の例 ---
# プール接続（アプリ実行用）。ホスト名に "-pooler" が含まれるものを使う。
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# 直結接続（prisma migrate 用）。"-pooler" を含まないホスト名。
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# 管理者ログインパスワード（本番では必ず強固な値に変更）
ADMIN_PASSWORD="change-me-strong-password"

# セッション署名鍵（本番では必ず設定・長いランダム文字列）
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-long-random-string"
